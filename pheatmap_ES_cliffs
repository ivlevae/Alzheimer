library(effsize)  


### ES2 - object with pathways 
all_res <- list()
pathway_cols <- intersect(names(gs), colnames(ES2))


grp_col   <- "True_Condition_PSEN"
grp_mut   <- "PSEN1 E280A"   
grp_wt    <- "PSEN1WT"       
min_cells <- 3              

for (ct in unique(ES2$cell_class)) {
  message(ct)
  ES2_ct <- ES2[ES2$cell_class == ct, , drop = FALSE]
  print(table(ES2_ct[[grp_col]]))
  

  res <- getSignificance(
    ES2_ct, group = grp_col, gene.sets = gs, fit = "Wilcoxon"
  )
  res$pathway   <- rownames(res)
  res$cell_type <- ct
  

  eff <- t(sapply(res$pathway, function(pw) {
    x   <- as.numeric(ES2_ct[[pw]])
    g   <- ES2_ct[[grp_col]]
    mut <- x[g == grp_mut]; mut <- mut[is.finite(mut)]
    wt  <- x[g == grp_wt];  wt  <- wt[is.finite(wt)]
    if (length(mut) < min_cells || length(wt) < min_cells)
      return(c(median_diff = NA_real_, cliff_delta = NA_real_))
    
    median_diff <- median(mut) - median(wt)                
    median_mutant <- median(mut)
    median_wt <- median(wt)  
    # Cliff's delta via Mann-Whitney U (fast, tie-aware)
    W  <- suppressWarnings(wilcox.test(mut, wt)$statistic)
    cd <- as.numeric(2 * W / (length(mut) * length(wt)) - 1)

    c(
      median_mutant = median_mutant,
      median_wt     = median_wt,
      median_diff   = median_diff,
      cliff_delta   = cd
    )
  }))
  
  res <- cbind(res, eff)
  all_res[[ct]] <- res
}

output <- do.call(rbind, all_res)
View(output)


output_sig <- subset(output, FDR < 0.05)

output_sig$cell_type
View(output_sig)
output_sig$pathway
df_full <- output_sig %>%
  mutate(
    cell_type = factor(cell_type, levels = cell_order),
    pathway   = factor(pathway,   levels = gs)
  ) %>%
  complete(cell_type, pathway, fill = list(cliff_delta = NA_real_))



ggplot(df_full, aes(x = pathway, y = cell_type, fill = cliff_delta)) +
